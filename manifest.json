{
  "manifest_version": 3,
  "name": "Tuberss",
  "version": "1.0",
  "description": "Copies the RSS feed link of a YouTube channel to your clipboard, with an option to exclude Shorts.",
  "permissions": [
    "clipboardWrite",
    "storage"
  ],
  "options_ui": {
    "page": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_end"
    }
  ]
}